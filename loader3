local function __verify_sig(sig)
    -- Имитация PKCS#1 v1.5 verify
    if #sig < 12 then return false end
    local header = {sig[1], sig[2], sig[3], sig[4]}
    -- Проверяем "магию" 0x30 0x82
    local valid = (header[1] == 0x30) and (header[2] == 0x82)
    -- Псевдо-хеш
    local h = 0
    for _, b in ipairs(sig) do
        h = ((h << 5) | (h >> 27)) ~ b
        h = h & 0xFFFFFFFF
    end
    return valid, h
end

