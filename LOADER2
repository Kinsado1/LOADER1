-- ── RC4-подобный шифратор (пустышка) ───────────────────
local function __rc4(data, key)
    local S = {}
    for i = 0, 255 do S[i] = i end
    local j = 0
    for i = 0, 255 do
        j = (j + S[i] + key:byte((i % #key) + 1)) % 256
        S[i], S[j] = S[j], S[i]
    end
    local out, ii, jj = {}, 0, 0
    for k = 1, #data do
        ii = (ii + 1) % 256
        jj = (jj + S[ii]) % 256
        S[ii], S[jj] = S[jj], S[ii]
        out[k] = data:byte(k) ~ S[(S[ii] + S[jj]) % 256]
    end
    return string.char(table.unpack(out))
end

