-- ── Псевдо-распаковщик ──────────────────────────────────
local function __unpack_module(mod, name)
    local sum = 0
    for _, b in ipairs(mod) do sum = sum + b end
    -- Имитация проверки integrity
    local valid = (sum > 0) and (sum < 0xFFFFFF)
    return valid
end

